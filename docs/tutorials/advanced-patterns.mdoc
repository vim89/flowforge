## 5. Custom Quality Rules: Domain-Specific Validation

FlowForge's dual-mode quality framework allows you to build sophisticated, domain-specific validation logic.

### Advanced Quality Rule Framework

```scala mdoc:silent
import com.flowforge.quality._
import com.flowforge.quality.deequ._

// Custom quality rule types
sealed trait QualityRuleType
case object BusinessRule extends QualityRuleType
case object DataIntegrity extends QualityRuleType
case object ReferentialIntegrity extends QualityRuleType
case object StatisticalAnomaly extends QualityRuleType

// Enhanced quality rule with metadata
case class EnhancedQualityRule[T](
  name: String,
  description: String,
  ruleType: QualityRuleType,
  severity: QualitySeverity,
  validator: T => Boolean,
  fixer: Option[T => T] = None,
  metadata: Map[String, String] = Map.empty
)

sealed trait QualitySeverity
case object Critical extends QualitySeverity
case object Warning extends QualitySeverity
case object Info extends QualitySeverity

// Financial domain-specific rules
object FinancialQualityRules {
  
  def transactionAmountRule: EnhancedQualityRule[Transaction] = 
    EnhancedQualityRule(
      name = "transaction_amount_valid",
      description = "Transaction amount must be positive and within reasonable limits",
      ruleType = BusinessRule,
      severity = Critical,
      validator = { tx =>
        tx.amount > 0 && tx.amount <= 1000000
      },
      metadata = Map(
        "domain" -> "financial",
        "regulation" -> "PCI-DSS"
      )
    )
  
  def accountBalanceConsistencyRule: EnhancedQualityRule[Account] =
    EnhancedQualityRule(
      name = "account_balance_consistency",
      description = "Account balance must equal sum of transactions",
      ruleType = DataIntegrity,
      severity = Critical,
      validator = { account =>
        val calculatedBalance = account.transactions.map(_.amount).sum
        math.abs(account.balance - calculatedBalance) < 0.01
      }
    )
  
  def fraudDetectionRule: EnhancedQualityRule[Transaction] =
    EnhancedQualityRule(
      name = "fraud_detection",
      description = "Detect potentially fraudulent transactions",
      ruleType = StatisticalAnomaly,
      severity = Warning,
      validator = { tx =>
        // Simple fraud detection logic
        val isHighAmount = tx.amount > 10000
        val isUnusualTime = tx.timestamp.getHour < 6 || tx.timestamp.getHour > 22
        val isUnusualLocation = tx.location.exists(_.country != tx.account.homeCountry)
        
        !(isHighAmount && isUnusualTime && isUnusualLocation)
      },
      metadata = Map(
        "ml_model" -> "fraud_detector_v2.1",
        "threshold" -> "0.85"
      )
    )
}

// Domain models
case class Transaction(
  id: String,
  accountId: String,
  amount: Double,
  timestamp: Instant,
  location: Option[Location],
  account: Account
)

case class Account(
  id: String,
  balance: Double,
  homeCountry: String,
  transactions: List[Transaction]
)

case class Location(
  country: String,
  city: String,
  coordinates: (Double, Double)
)
```

### Dual-Mode Quality Engine

```scala mdoc:silent
class DualModeQualityEngine[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def validateWithDualMode[T](
    dataset: D[T],
    nativeRules: List[EnhancedQualityRule[T]],
    deequChecks: List[Check] = List.empty
  ): F[QualityReport[T]] = {
    
    for {
      // Run native FlowForge validation
      nativeResults <- runNativeValidation(dataset, nativeRules)
      
      // Run Deequ validation if configured
      deequResults <- if (deequChecks.nonEmpty) {
        runDeequValidation(dataset, deequChecks)
      } else {
        EffectSystem[F].pure(DeequResults.empty)
      }
      
      // Combine results
      combinedReport = combineQualityResults(nativeResults, deequResults)
      
      // Apply auto-fixing for fixable issues
      fixedDataset <- applyAutoFixes(dataset, nativeRules, nativeResults)
      
    } yield QualityReport(
      originalDataset = dataset,
      fixedDataset = fixedDataset,
      nativeResults = nativeResults,
      deequResults = deequResults,
      combinedReport = combinedReport
    )
  }
  
  private def runNativeValidation[T](
    dataset: D[T],
    rules: List[EnhancedQualityRule[T]]
  ): F[NativeQualityResults[T]] = {
    
    EffectSystem[F].delay {
      val results = rules.map { rule =>
        val validRecords = DataAlgebra[D].filter(dataset)(rule.validator)
        val invalidRecords = DataAlgebra[D].filter(dataset)(record => !rule.validator(record))
        
        val validCount = DataAlgebra[D].count(validRecords)
        val invalidCount = DataAlgebra[D].count(invalidRecords)
        val totalCount = validCount + invalidCount
        
        val successRate = if (totalCount > 0) validCount.toDouble / totalCount else 1.0
        
        NativeRuleResult(
          rule = rule,
          successRate = successRate,
          validCount = validCount,
          invalidCount = invalidCount,
          invalidRecords = invalidRecords
        )
      }
      
      NativeQualityResults(results)
    }
  }
  
  private def runDeequValidation[T](
    dataset: D[T],
    checks: List[Check]
  ): F[DeequResults] = {
    EffectSystem[F].delay {
      // Convert FlowForge dataset to Spark DataFrame for Deequ
      val sparkDF = DataAlgebra[D].toSparkDataFrame(dataset)
      
      // Run Deequ verification
      val verificationResult = VerificationSuite()
        .onData(sparkDF)
        .addChecks(checks)
        .run()
      
      DeequResults(verificationResult)
    }
  }
  
  private def combineQualityResults[T](
    nativeResults: NativeQualityResults[T],
    deequResults: DeequResults
  ): CombinedQualityReport = {
    
    val criticalIssues = nativeResults.results.filter(_.rule.severity == Critical)
    val warningIssues = nativeResults.results.filter(_.rule.severity == Warning)
    
    val overallSuccessRate = nativeResults.results.map(_.successRate).sum / nativeResults.results.length
    
    CombinedQualityReport(
      overallSuccessRate = overallSuccessRate,
      criticalIssues = criticalIssues.length,
      warningIssues = warningIssues.length,
      deequConstraintViolations = deequResults.constraintResults.count(!_.status.isSuccess),
      recommendations = generateRecommendations(nativeResults, deequResults)
    )
  }
  
  private def applyAutoFixes[T](
    dataset: D[T],
    rules: List[EnhancedQualityRule[T]],
    results: NativeQualityResults[T]
  ): F[D[T]] = {
    
    val fixableRules = rules.filter(_.fixer.isDefined)
    
    EffectSystem[F].pure {
      fixableRules.foldLeft(dataset) { (currentDataset, rule) =>
        DataAlgebra[D].map(currentDataset) { record =>
          if (!rule.validator(record) && rule.fixer.isDefined) {
            rule.fixer.get(record)
          } else {
            record
          }
        }
      }
    }
  }
  
  private def generateRecommendations(
    nativeResults: NativeQualityResults[_],
    deequResults: DeequResults
  ): List[QualityRecommendation] = {
    
    val recommendations = scala.collection.mutable.ListBuffer[QualityRecommendation]()
    
    // Analyze native results
    nativeResults.results.foreach { result =>
      if (result.successRate < 0.95) {
        recommendations += QualityRecommendation(
          priority = if (result.rule.severity == Critical) "HIGH" else "MEDIUM",
          message = s"Rule '${result.rule.name}' has low success rate: ${(result.successRate * 100).toInt}%",
          action = "Review data quality processes and consider data cleansing",
          affectedRecords = result.invalidCount
        )
      }
    }
    
    // Analyze Deequ results
    deequResults.constraintResults.foreach { constraint =>
      if (!constraint.status.isSuccess) {
        recommendations += QualityRecommendation(
          priority = "HIGH",
          message = s"Deequ constraint failed: ${constraint.constraint}",
          action = "Investigate data source and implement data validation",
          affectedRecords = 0 // Deequ doesn't provide this directly
        )
      }
    }
    
    recommendations.toList
  }
}

// Quality result types
case class QualityReport[T](
  originalDataset: D[T],
  fixedDataset: D[T],
  nativeResults: NativeQualityResults[T],
  deequResults: DeequResults,
  combinedReport: CombinedQualityReport
)

case class NativeQualityResults[T](results: List[NativeRuleResult[T]])

case class NativeRuleResult[T](
  rule: EnhancedQualityRule[T],
  successRate: Double,
  validCount: Long,
  invalidCount: Long,
  invalidRecords: D[T]
)

case class CombinedQualityReport(
  overallSuccessRate: Double,
  criticalIssues: Int,
  warningIssues: Int,
  deequConstraintViolations: Int,
  recommendations: List[QualityRecommendation]
)

case class QualityRecommendation(
  priority: String,
  message: String,
  action: String,
  affectedRecords: Long
)
```

### Quality Pipeline Integration

```scala mdoc:silent
class QualityAwareDataPipeline[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def processWithQuality[T](
    inputPath: String,
    outputPath: String,
    qualityRules: List[EnhancedQualityRule[T]],
    qualityThreshold: Double = 0.95
  ): F[Unit] = {
    
    val qualityEngine = new DualModeQualityEngine[F, D]()
    
    for {
      // Read input data
      dataset <- DataAlgebra[D].read[T](inputPath)
      
      // Run quality validation
      qualityReport <- qualityEngine.validateWithDualMode(
        dataset, 
        qualityRules,
        buildDeequChecks[T]()
      )
      
      // Check if quality meets threshold
      _ <- if (qualityReport.combinedReport.overallSuccessRate >= qualityThreshold) {
        EffectSystem[F].pure(())
      } else {
        EffectSystem[F].raiseError(
          QualityThresholdException(
            s"Quality threshold not met: ${qualityReport.combinedReport.overallSuccessRate} < $qualityThreshold"
          )
        )
      }
      
      // Use fixed dataset if auto-fixes were applied
      finalDataset = qualityReport.fixedDataset
      
      // Write output
      _ <- DataAlgebra[D].write(finalDataset, outputPath)
      
      // Emit quality metrics
      _ <- emitQualityMetrics(qualityReport)
      
    } yield ()
  }
  
  private def buildDeequChecks[T](): List[Check] = {
    // Build Deequ checks based on data type
    List(
      Check(CheckLevel.Error, "Basic Data Quality")
        .hasSize(_ > 0)
        .isComplete("id")
        .hasUniqueness("id", _ == 1.0)
    )
  }
  
  private def emitQualityMetrics[T](report: QualityReport[T]): F[Unit] = {
    EffectSystem[F].delay {
      // Emit metrics to monitoring system
      val metrics = Map(
        "quality.success_rate" -> report.combinedReport.overallSuccessRate,
        "quality.critical_issues" -> report.combinedReport.criticalIssues.toDouble,
        "quality.warning_issues" -> report.combinedReport.warningIssues.toDouble,
        "quality.deequ_violations" -> report.combinedReport.deequConstraintViolations.toDouble
      )
      
      MetricsEmitter.emit("data_quality", metrics)
    }
  }
}

case class QualityThresholdException(message: String) extends Exception(message)
```

## 6. Performance Optimization: Production-Scale Tuning

Performance is critical for production data pipelines. Let's explore FlowForge's performance optimization techniques.

### Performance Monitoring and Benchmarking

```scala mdoc:silent
import com.flowforge.performance._
import java.util.concurrent.TimeUnit

class PerformanceOptimizedPipeline[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def runWithPerformanceMonitoring[T](
    operation: D[T] => F[D[T]],
    dataset: D[T],
    operationName: String
  ): F[PerformanceResult[T]] = {
    
    for {
      // Start performance monitoring
      startTime <- EffectSystem[F].delay(System.nanoTime())
      startMemory <- EffectSystem[F].delay(getMemoryUsage())
      
      // Run operation with resource monitoring
      result <- EffectSystem[F].bracket(
        acquire = EffectSystem[F].delay(startResourceMonitoring(operationName))
      )(
        use = _ => operation(dataset)
      )(
        release = monitor => EffectSystem[F].delay(stopResourceMonitoring(monitor))
      )
      
      // Capture end metrics
      endTime <- EffectSystem[F].delay(System.nanoTime())
      endMemory <- EffectSystem[F].delay(getMemoryUsage())
      
      // Calculate performance metrics
      duration = TimeUnit.NANOSECONDS.toMillis(endTime - startTime)
      memoryDelta = endMemory - startMemory
      recordCount = DataAlgebra[D].count(result)
      throughput = if (duration > 0) recordCount * 1000.0 / duration else 0.0
      
      performanceMetrics = PerformanceMetrics(
        operationName = operationName,
        duration = duration,
        memoryUsage = memoryDelta,
        recordCount = recordCount,
        throughput = throughput,
        timestamp = Instant.now()
      )
      
      // Emit performance metrics
      _ <- emitPerformanceMetrics(performanceMetrics)
      
    } yield PerformanceResult(result, performanceMetrics)
  }
  
  private def getMemoryUsage(): Long = {
    val runtime = Runtime.getRuntime
    runtime.totalMemory() - runtime.freeMemory()
  }
  
  private def startResourceMonitoring(operationName: String): ResourceMonitor = {
    ResourceMonitor.start(operationName)
  }
  
  private def stopResourceMonitoring(monitor: ResourceMonitor): Unit = {
    monitor.stop()
  }
  
  private def emitPerformanceMetrics(metrics: PerformanceMetrics): F[Unit] = {
    EffectSystem[F].delay {
      MetricsEmitter.emit("performance", Map(
        "operation" -> metrics.operationName,
        "duration_ms" -> metrics.duration.toDouble,
        "memory_mb" -> (metrics.memoryUsage / 1024.0 / 1024.0),
        "record_count" -> metrics.recordCount.toDouble,
        "throughput_records_per_sec" -> metrics.throughput
      ))
    }
  }
}

case class PerformanceResult[T](
  result: D[T],
  metrics: PerformanceMetrics
)

case class PerformanceMetrics(
  operationName: String,
  duration: Long,
  memoryUsage: Long,
  recordCount: Long,
  throughput: Double,
  timestamp: Instant
)
```

### Optimization Strategies

```scala mdoc:silent
object OptimizationStrategies {
  
  // 1. Schema Optimization
  def optimizeSchemaForPerformance[T](implicit evidence: DataContract[T]): SchemaOptimization = {
    val schema = evidence.schema
    
    SchemaOptimization(
      recommendations = List(
        // Suggest primitive types over complex types
        if (schema.fields.exists(_.dataType.isInstanceOf[StructType])) {
          "Consider flattening nested structures for better performance"
        } else "",
        
        // Suggest appropriate partitioning
        if (schema.fields.exists(_.name.contains("date"))) {
          "Consider partitioning by date fields for better query performance"
        } else "",
        
        // Suggest column ordering
        "Order frequently accessed columns first in the schema"
      ).filter(_.nonEmpty),
      
      estimatedImprovementPercent = calculateEstimatedImprovement(schema)
    )
  }
  
  // 2. Caching Strategy
  def applyCachingStrategy[F[_]: EffectSystem, D[_]: DataAlgebra, T](
    dataset: D[T],
    accessPattern: AccessPattern
  ): F[D[T]] = {
    accessPattern match {
      case MultipleAccess(count) if count > 3 =>
        EffectSystem[F].delay(DataAlgebra[D].cache(dataset))
      case LargeDataset(sizeGB) if sizeGB > 10 =>
        EffectSystem[F].delay(DataAlgebra[D].persist(dataset, StorageLevel.MEMORY_AND_DISK_SER))
      case _ =>
        EffectSystem[F].pure(dataset)
    }
  }
  
  // 3. Partitioning Optimization
  def optimizePartitioning[F[_]: EffectSystem, D[_]: DataAlgebra, T](
    dataset: D[T],
    partitionColumns: List[String],
    targetPartitionSize: Long = 128 * 1024 * 1024 // 128MB
  ): F[D[T]] = {
    
    for {
      // Analyze current partitioning
      currentPartitions <- EffectSystem[F].delay(DataAlgebra[D].getNumPartitions(dataset))
      datasetSize <- EffectSystem[F].delay(DataAlgebra[D].estimateSize(dataset))
      
      // Calculate optimal partition count
      optimalPartitions = math.max(1, (datasetSize / targetPartitionSize).toInt)
      
      // Repartition if needed
      optimizedDataset <- if (math.abs(currentPartitions - optimalPartitions) > currentPartitions * 0.2) {
        EffectSystem[F].delay {
          if (partitionColumns.nonEmpty) {
            DataAlgebra[D].repartition(dataset, optimalPartitions, partitionColumns)
          } else {
            DataAlgebra[D].repartition(dataset, optimalPartitions)
          }
        }
      } else {
        EffectSystem[F].pure(dataset)
      }
      
    } yield optimizedDataset
  }
  
  // 4. Join Optimization
  def optimizeJoin[F[_]: EffectSystem, D[_]: DataAlgebra, T, U, V](
    left: D[T],
    right: D[U],
    joinCondition: (T, U) => Boolean,
    joinType: JoinType = InnerJoin
  ): F[D[V]] = {
    
    for {
      // Analyze join characteristics
      leftSize <- EffectSystem[F].delay(DataAlgebra[D].estimateSize(left))
      rightSize <- EffectSystem[F].delay(DataAlgebra[D].estimateSize(right))
      
      // Choose optimal join strategy
      optimizedJoin <- if (rightSize < leftSize * 0.1) {
        // Broadcast join for small right dataset
        EffectSystem[F].delay(DataAlgebra[D].broadcastJoin(left, right, joinCondition, joinType))
      } else if (leftSize < rightSize * 0.1) {
        // Broadcast join for small left dataset
        EffectSystem[F].delay(DataAlgebra[D].broadcastJoin(right, left, joinCondition.flip, joinType))
      } else {
        // Sort-merge join for large datasets
        EffectSystem[F].delay(DataAlgebra[D].sortMergeJoin(left, right, joinCondition, joinType))
      }
      
    } yield optimizedJoin
  }
  
  private def calculateEstimatedImprovement(schema: StructType): Double = {
    // Simple heuristic for performance improvement estimation
    val complexityScore = schema.fields.map { field =>
      field.dataType match {
        case _: StringType => 1.0
        case _: IntegerType => 0.5
        case _: LongType => 0.5
        case _: DoubleType => 0.5
        case _: StructType => 3.0
        case _: ArrayType => 2.0
        case _: MapType => 2.5
        case _ => 1.0
      }
    }.sum
    
    math.min(50.0, complexityScore * 2.0) // Cap at 50% improvement
  }
}

// Supporting types
case class SchemaOptimization(
  recommendations: List[String],
  estimatedImprovementPercent: Double
)

sealed trait AccessPattern
case class MultipleAccess(count: Int) extends AccessPattern
case class LargeDataset(sizeGB: Double) extends AccessPattern
case object SingleAccess extends AccessPattern

sealed trait JoinType
case object InnerJoin extends JoinType
case object LeftJoin extends JoinType
case object RightJoin extends JoinType
case object FullJoin extends JoinType

sealed trait StorageLevel
case object MEMORY_ONLY extends StorageLevel
case object MEMORY_AND_DISK extends StorageLevel
case object MEMORY_AND_DISK_SER extends StorageLevel
```

### Production Deployment Patterns

```scala mdoc:silent
class ProductionPipelineTemplate[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def runProductionPipeline[T](
    config: ProductionConfig,
    operation: D[T] => F[D[T]]
  ): F[PipelineResult] = {
    
    for {
      // Initialize monitoring
      _ <- initializeMonitoring(config)
      
      // Setup error handling
      result <- EffectSystem[F].handleErrorWith(
        runPipelineWithRetries(config, operation)
      )(handlePipelineFailure)
      
      // Cleanup resources
      _ <- cleanupResources(config)
      
    } yield result
  }
  
  private def runPipelineWithRetries[T](
    config: ProductionConfig,
    operation: D[T] => F[D[T]]
  ): F[PipelineResult] = {
    
    def attemptPipeline(attempt: Int): F[PipelineResult] = {
      for {
        // Load data with validation
        dataset <- loadDataWithValidation[T](config.inputPath)
        
        // Apply performance optimizations
        optimizedDataset <- applyOptimizations(dataset, config.optimizations)
        
        // Run the operation
        result <- operation(optimizedDataset)
        
        // Validate output
        validatedResult <- validateOutput(result, config.qualityRules)
        
        // Save with atomic write
        _ <- atomicWrite(validatedResult, config.outputPath)
        
        // Update metadata
        _ <- updatePipelineMetadata(config, success = true)
        
      } yield PipelineResult.success(validatedResult)
    }
    
    def retryLogic(attempt: Int, error: Throwable): F[PipelineResult] = {
      if (attempt < config.maxRetries && isRetryableError(error)) {
        for {
          _ <- EffectSystem[F].delay(Thread.sleep(config.retryDelay * attempt))
          _ <- logRetryAttempt(attempt, error)
          result <- attemptPipeline(attempt + 1)
        } yield result
      } else {
        EffectSystem[F].raiseError(error)
      }
    }
    
    EffectSystem[F].handleErrorWith(attemptPipeline(1))(retryLogic(1, _))
  }
  
  private def loadDataWithValidation[T](path: String): F[D[T]] = {
    for {
      // Load data
      dataset <- DataAlgebra[D].read[T](path)
      
      // Validate schema contracts
      validatedDataset = DataContract.validate(dataset)
      
      // Check data freshness
      _ <- validateDataFreshness(dataset)
      
    } yield validatedDataset
  }
  
  private def applyOptimizations[T](
    dataset: D[T],
    optimizations: OptimizationConfig
  ): F[D[T]] = {
    
    for {
      // Apply caching if configured
      cached <- if (optimizations.enableCaching) {
        OptimizationStrategies.applyCachingStrategy(dataset, optimizations.accessPattern)
      } else {
        EffectSystem[F].pure(dataset)
      }
      
      // Optimize partitioning
      partitioned <- if (optimizations.optimizePartitioning) {
        OptimizationStrategies.optimizePartitioning(
          cached, 
          optimizations.partitionColumns,
          optimizations.targetPartitionSize
        )
      } else {
        EffectSystem[F].pure(cached)
      }
      
    } yield partitioned
  }
  
  private def atomicWrite[T](dataset: D[T], path: String): F[Unit] = {
    val tempPath = s"${path}_temp_${System.currentTimeMillis()}"
    
    for {
      // Write to temporary location
      _ <- DataAlgebra[D].write(dataset, tempPath)
      
      // Atomic move to final location
      _ <- EffectSystem[F].delay {
        // Implementation depends on storage system
        // For HDFS/S3: rename operation
        // For Delta Lake: commit transaction
        atomicMove(tempPath, path)
      }
      
    } yield ()
  }
  
  private def handlePipelineFailure(error: Throwable): F[PipelineResult] = {
    for {
      // Log error details
      _ <- logPipelineError(error)
      
      // Send alerts
      _ <- sendFailureAlert(error)
      
      // Update metadata
      _ <- updatePipelineMetadata(ProductionConfig.default, success = false)
      
    } yield PipelineResult.failure(error)
  }
  
  // Helper methods
  private def initializeMonitoring(config: ProductionConfig): F[Unit] = ???
  private def cleanupResources(config: ProductionConfig): F[Unit] = ???
  private def validateDataFreshness[T](dataset: D[T]): F[Unit] = ???
  private def validateOutput[T](dataset: D[T], rules: List[QualityRule]): F[D[T]] = ???
  private def updatePipelineMetadata(config: ProductionConfig, success: Boolean): F[Unit] = ???
  private def isRetryableError(error: Throwable): Boolean = ???
  private def logRetryAttempt(attempt: Int, error: Throwable): F[Unit] = ???
  private def logPipelineError(error: Throwable): F[Unit] = ???
  private def sendFailureAlert(error: Throwable): F[Unit] = ???
  private def atomicMove(from: String, to: String): Unit = ???
}

// Configuration types
case class ProductionConfig(
  inputPath: String,
  outputPath: String,
  maxRetries: Int = 3,
  retryDelay: Long = 5000,
  optimizations: OptimizationConfig = OptimizationConfig.default,
  qualityRules: List[QualityRule] = List.empty,
  monitoring: MonitoringConfig = MonitoringConfig.default
)

case class OptimizationConfig(
  enableCaching: Boolean = true,
  optimizePartitioning: Boolean = true,
  partitionColumns: List[String] = List.empty,
  targetPartitionSize: Long = 128 * 1024 * 1024,
  accessPattern: AccessPattern = SingleAccess
)

object OptimizationConfig {
  def default: OptimizationConfig = OptimizationConfig()
}

case class MonitoringConfig(
  enableMetrics: Boolean = true,
  enableLineage: Boolean = true,
  alertingEnabled: Boolean = true
)

object MonitoringConfig {
  def default: MonitoringConfig = MonitoringConfig()
}

object ProductionConfig {
  def default: ProductionConfig = ProductionConfig("", "")
}

sealed trait PipelineResult
object PipelineResult {
  case class Success[T](data: D[T]) extends PipelineResult
  case class Failure(error: Throwable) extends PipelineResult
  
  def success[T](data: D[T]): PipelineResult = Success(data)
  def failure(error: Throwable): PipelineResult = Failure(error)
}
```

## Conclusion

This tutorial covered advanced FlowForge patterns that enable sophisticated data engineering at scale:

1. **Multi-Engine Pipelines**: Write business logic once, run on Spark or Flink
2. **Complex Schema Evolution**: Handle breaking changes gracefully with policy-based evolution
3. **Streaming CDC**: Real-time change data capture with schema validation and SCD2 patterns
4. **Multi-Cloud Integration**: Unified data processing across AWS, Azure, and GCP
5. **Custom Quality Rules**: Domain-specific validation with dual-mode quality framework
6. **Performance Optimization**: Production-scale tuning with monitoring and benchmarking

### Next Steps

- Explore the [Performance Benchmarks](../performance-benchmarks/README.md) for detailed optimization guidance
- Review the [Migration Guides](../migration/) for transitioning from other tools
- Check out the [Advanced Examples](https://github.com/flowforge/flowforge.g8) in the project template
- Join the [FlowForge Community](https://discord.gg/flowforge) for discussions and support

### Performance Considerations

When implementing these patterns in production:

1. **Monitor Compilation Time**: Complex schemas can increase compilation time
2. **Optimize for Your Use Case**: Choose the right schema policies and optimization strategies
3. **Test at Scale**: Validate performance with production-sized datasets
4. **Implement Gradual Rollouts**: Use feature flags for new optimizations
5. **Monitor Resource Usage**: Track memory, CPU, and network utilization

Remember that FlowForge's compile-time contract validation provides safety guarantees that traditional runtime validation cannot match, making these advanced patterns both powerful and reliable for production use.