# Advanced FlowForge Patterns

This tutorial covers sophisticated FlowForge patterns for users who have mastered the basics and want to explore advanced capabilities. We'll dive into multi-engine pipelines, complex schema evolution, streaming CDC, multi-cloud integration, custom quality rules, and production-scale performance optimization.

## Prerequisites

Before starting this tutorial, ensure you have:
- Completed the [First Contract](first-contract.md) tutorial
- Understanding of FlowForge's contract validation system
- Familiarity with either Spark or Flink
- Basic knowledge of data engineering concepts

## Setup

Generate a new FlowForge project with advanced examples:

```bash
sbt new flowforge/flowforge.g8
# Choose project name: advanced-patterns-demo
# Include advanced examples: yes
```

## 1. Multi-Engine Pipelines: Engine-Agnostic Business Logic

FlowForge's engine abstraction allows you to write business logic once and run it on different execution engines. Let's explore this with a real-world customer analytics pipeline.

### Defining Engine-Agnostic Contracts

First, let's define our data contracts that work across all engines:

```scala mdoc:silent
import com.flowforge.core.contracts._
import com.flowforge.core.contracts.policies._

// Customer event contract - works on both Spark and Flink
case class CustomerEvent(
  customerId: Long,
  eventType: String,
  timestamp: Long,
  properties: Map[String, String]
)

// Aggregated customer metrics contract
case class CustomerMetrics(
  customerId: Long,
  totalEvents: Long,
  uniqueEventTypes: Int,
  lastActivity: Long,
  engagementScore: Double
)

// Define schema policies for evolution
object CustomerContracts {
  implicit val eventPolicy: SchemaPolicy[CustomerEvent] = Backward
  implicit val metricsPolicy: SchemaPolicy[CustomerMetrics] = Forward
}
```

### Engine-Agnostic Business Logic

Now let's implement the core business logic using FlowForge's algebra:

```scala mdoc:silent
import com.flowforge.core.algebra._
import com.flowforge.core.contracts.validation._

class CustomerAnalytics[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def processCustomerEvents(
    events: D[CustomerEvent]
  ): F[D[CustomerMetrics]] = {
    
    // Validate input contracts at compile time
    val validatedEvents = DataContract.validate(events)
    
    // Core business logic - engine agnostic
    val aggregated = DataAlgebra[D].groupBy(validatedEvents)(_.customerId)
      .aggregate { group =>
        val totalEvents = DataAlgebra[D].count(group)
        val uniqueTypes = DataAlgebra[D].distinct(
          DataAlgebra[D].select(group)(_.eventType)
        ).count
        val lastActivity = DataAlgebra[D].max(
          DataAlgebra[D].select(group)(_.timestamp)
        )
        
        // Calculate engagement score based on recency and frequency
        val engagementScore = calculateEngagementScore(totalEvents, lastActivity)
        
        CustomerMetrics(
          customerId = group.key,
          totalEvents = totalEvents,
          uniqueEventTypes = uniqueTypes,
          lastActivity = lastActivity,
          engagementScore = engagementScore
        )
      }
    
    // Validate output contracts
    EffectSystem[F].pure(DataContract.validate(aggregated))
  }
  
  private def calculateEngagementScore(events: Long, lastActivity: Long): Double = {
    val recencyWeight = 0.6
    val frequencyWeight = 0.4
    val now = System.currentTimeMillis()
    val daysSinceActivity = (now - lastActivity) / (1000 * 60 * 60 * 24)
    val recencyScore = math.max(0, 1.0 - (daysSinceActivity / 30.0))
    val frequencyScore = math.min(1.0, events / 100.0)
    
    recencyWeight * recencyScore + frequencyWeight * frequencyScore
  }
}
```

### Spark Implementation

```scala mdoc:silent
import com.flowforge.engines.spark._
import org.apache.spark.sql.SparkSession
import cats.effect.IO

class SparkCustomerAnalytics(implicit spark: SparkSession) 
  extends CustomerAnalytics[IO, SparkData] {
  
  def runPipeline(inputPath: String, outputPath: String): IO[Unit] = {
    for {
      // Read events with automatic schema validation
      events <- SparkData.read[CustomerEvent](inputPath)
      
      // Process using engine-agnostic logic
      metrics <- processCustomerEvents(events)
      
      // Write with contract validation
      _ <- SparkData.write(metrics, outputPath)
      
      // Emit lineage information
      _ <- emitLineage("customer-analytics-spark", inputPath, outputPath)
      
    } yield ()
  }
  
  private def emitLineage(jobName: String, input: String, output: String): IO[Unit] = {
    // OpenLineage emission for Spark
    IO.delay {
      val lineageEvent = OpenLineageEvent(
        jobName = jobName,
        inputs = List(input),
        outputs = List(output),
        engine = "spark"
      )
      OpenLineageEmitter.emit(lineageEvent)
    }
  }
}
```

### Flink Implementation

```scala mdoc:silent
import com.flowforge.engines.flink._
import org.apache.flink.streaming.api.scala.StreamExecutionEnvironment
import zio.Task

class FlinkCustomerAnalytics(implicit env: StreamExecutionEnvironment)
  extends CustomerAnalytics[Task, FlinkStream] {
  
  def runStreamingPipeline(kafkaTopic: String, outputTopic: String): Task[Unit] = {
    for {
      // Read streaming events with schema validation
      events <- FlinkStream.readFromKafka[CustomerEvent](kafkaTopic)
      
      // Apply windowing for streaming aggregation
      windowedEvents = FlinkStream.window(events, 
        windowSize = Duration.ofMinutes(5),
        slideSize = Duration.ofMinutes(1)
      )
      
      // Process using the same business logic
      metrics <- processCustomerEvents(windowedEvents)
      
      // Write to output with contract validation
      _ <- FlinkStream.writeToKafka(metrics, outputTopic)
      
      // Start the streaming job
      _ <- Task.delay(env.execute("customer-analytics-flink"))
      
    } yield ()
  }
}
```

### Testing Engine Equivalence

Verify that both engines produce identical results:

```scala mdoc:silent
import com.flowforge.testing._

class EngineEquivalenceTest extends FlowForgeSpec {
  
  "Customer analytics" should "produce identical results on Spark and Flink" in {
    val testEvents = List(
      CustomerEvent(1L, "login", 1000L, Map("device" -> "mobile")),
      CustomerEvent(1L, "purchase", 2000L, Map("amount" -> "99.99")),
      CustomerEvent(2L, "login", 1500L, Map("device" -> "desktop"))
    )
    
    // Run on Spark
    val sparkResults = withSparkSession { implicit spark =>
      val analytics = new SparkCustomerAnalytics()
      val events = SparkData.fromSeq(testEvents)
      analytics.processCustomerEvents(events).unsafeRunSync()
    }
    
    // Run on Flink (batch mode for testing)
    val flinkResults = withFlinkEnvironment { implicit env =>
      val analytics = new FlinkCustomerAnalytics()
      val events = FlinkStream.fromSeq(testEvents)
      analytics.processCustomerEvents(events).unsafeRun()
    }
    
    // Results should be identical
    sparkResults.collect() should contain theSameElementsAs flinkResults.collect()
  }
}
```

## 2. Complex Schema Evolution: Managing Breaking Changes

Real-world data evolves constantly. FlowForge's schema policies help manage this evolution gracefully. Let's explore advanced schema evolution patterns.

### Schema Evolution Scenarios

```scala mdoc:silent
// Version 1: Initial customer schema
case class CustomerV1(
  id: Long,
  name: String,
  email: String
)

// Version 2: Added optional phone field (Backward compatible)
case class CustomerV2(
  id: Long,
  name: String,
  email: String,
  phone: Option[String] = None
)

// Version 3: Split name into first/last (Breaking change)
case class CustomerV3(
  id: Long,
  firstName: String,
  lastName: String,
  email: String,
  phone: Option[String] = None
)

// Version 4: Made email optional (Forward compatible)
case class CustomerV4(
  id: Long,
  firstName: String,
  lastName: String,
  email: Option[String] = None,
  phone: Option[String] = None
)
```

### Policy-Based Evolution Strategy

```scala mdoc:silent
import com.flowforge.core.contracts.policies._

object CustomerEvolution {
  
  // Backward policy: Allow new optional fields
  implicit val v1ToV2Policy: SchemaPolicy[CustomerV2] = Backward
  
  // Full policy: Handle breaking changes with transformation
  implicit val v2ToV3Policy: SchemaPolicy[CustomerV3] = Full
  
  // Forward policy: Allow field removal
  implicit val v3ToV4Policy: SchemaPolicy[CustomerV4] = Forward
  
  // Custom transformation for breaking changes
  def transformV2ToV3(v2: CustomerV2): CustomerV3 = {
    val nameParts = v2.name.split(" ", 2)
    CustomerV3(
      id = v2.id,
      firstName = nameParts.headOption.getOrElse(""),
      lastName = nameParts.lift(1).getOrElse(""),
      email = v2.email,
      phone = v2.phone
    )
  }
}
```

### Schema Migration Pipeline

```scala mdoc:silent
class SchemaMigrationPipeline[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def migrateCustomerData(
    inputPath: String,
    outputPath: String,
    sourceVersion: String,
    targetVersion: String
  ): F[Unit] = {
    
    (sourceVersion, targetVersion) match {
      case ("v1", "v2") => migrateV1ToV2(inputPath, outputPath)
      case ("v2", "v3") => migrateV2ToV3(inputPath, outputPath)
      case ("v3", "v4") => migrateV3ToV4(inputPath, outputPath)
      case _ => EffectSystem[F].raiseError(
        new IllegalArgumentException(s"Unsupported migration: $sourceVersion -> $targetVersion")
      )
    }
  }
  
  private def migrateV1ToV2(inputPath: String, outputPath: String): F[Unit] = {
    for {
      // Read V1 data
      v1Data <- DataAlgebra[D].read[CustomerV1](inputPath)
      
      // Transform to V2 (automatic with Backward policy)
      v2Data = DataAlgebra[D].map(v1Data) { v1 =>
        CustomerV2(v1.id, v1.name, v1.email, None)
      }
      
      // Validate contracts
      validated = DataContract.validate(v2Data)
      
      // Write V2 data
      _ <- DataAlgebra[D].write(validated, outputPath)
      
    } yield ()
  }
  
  private def migrateV2ToV3(inputPath: String, outputPath: String): F[Unit] = {
    for {
      // Read V2 data
      v2Data <- DataAlgebra[D].read[CustomerV2](inputPath)
      
      // Transform with custom logic for breaking change
      v3Data = DataAlgebra[D].map(v2Data)(CustomerEvolution.transformV2ToV3)
      
      // Validate contracts with Full policy
      validated = DataContract.validate(v3Data)
      
      // Write V3 data
      _ <- DataAlgebra[D].write(validated, outputPath)
      
    } yield ()
  }
  
  private def migrateV3ToV4(inputPath: String, outputPath: String): F[Unit] = {
    for {
      // Read V3 data
      v3Data <- DataAlgebra[D].read[CustomerV3](inputPath)
      
      // Transform to V4 (automatic with Forward policy)
      v4Data = DataAlgebra[D].map(v3Data) { v3 =>
        CustomerV4(v3.id, v3.firstName, v3.lastName, Some(v3.email), v3.phone)
      }
      
      // Validate contracts
      validated = DataContract.validate(v4Data)
      
      // Write V4 data
      _ <- DataAlgebra[D].write(validated, outputPath)
      
    } yield ()
  }
}
```

### Schema Evolution Testing

```scala mdoc:silent
class SchemaEvolutionTest extends FlowForgeSpec {
  
  "Schema migration" should "preserve data integrity across versions" in {
    val originalV1 = CustomerV1(1L, "John Doe", "john@example.com")
    
    // Test V1 -> V2 migration
    val v2Result = CustomerV2(originalV1.id, originalV1.name, originalV1.email, None)
    v2Result.id shouldBe originalV1.id
    v2Result.email shouldBe originalV1.email
    
    // Test V2 -> V3 migration with name splitting
    val v3Result = CustomerEvolution.transformV2ToV3(v2Result)
    v3Result.firstName shouldBe "John"
    v3Result.lastName shouldBe "Doe"
    v3Result.email shouldBe originalV1.email
    
    // Test V3 -> V4 migration
    val v4Result = CustomerV4(
      v3Result.id, v3Result.firstName, v3Result.lastName, 
      Some(v3Result.email), v3Result.phone
    )
    v4Result.email shouldBe Some(originalV1.email)
  }
  
  "Schema policies" should "catch incompatible changes at compile time" in {
    // This should fail to compile with Exact policy
    """
    implicit val exactPolicy: SchemaPolicy[CustomerV2] = Exact
    val v1Data: Dataset[CustomerV1] = ???
    val v2Data: Dataset[CustomerV2] = DataContract.validate(v1Data)
    """ shouldNot compile
  }
}
```

## 3. Streaming CDC: Real-Time Change Data Capture

Change Data Capture (CDC) is crucial for real-time data synchronization. Let's build a sophisticated CDC pipeline with FlowForge.

### CDC Event Contracts

```scala mdoc:silent
import java.time.Instant

// CDC operation types
sealed trait CDCOperation
case object Insert extends CDCOperation
case object Update extends CDCOperation
case object Delete extends CDCOperation

// Generic CDC event structure
case class CDCEvent[T](
  operation: CDCOperation,
  timestamp: Instant,
  before: Option[T],
  after: Option[T],
  source: CDCSource
)

case class CDCSource(
  database: String,
  table: String,
  lsn: Long // Log Sequence Number
)

// Customer CDC events
case class CustomerCDC(
  customerId: Long,
  name: String,
  email: String,
  status: String,
  updatedAt: Instant
)

object CDCContracts {
  implicit val customerCDCPolicy: SchemaPolicy[CustomerCDC] = Backward
  implicit val cdcEventPolicy: SchemaPolicy[CDCEvent[CustomerCDC]] = Full
}
```

### Streaming CDC Processor

```scala mdoc:silent
import com.flowforge.streaming._
import com.flowforge.quality._

class StreamingCDCProcessor[F[_]: EffectSystem, S[_]: StreamAlgebra] {
  
  def processCDCStream(
    kafkaTopic: String,
    deltaTablePath: String
  ): F[Unit] = {
    
    for {
      // Read CDC events from Kafka
      cdcStream <- StreamAlgebra[S].readFromKafka[CDCEvent[CustomerCDC]](kafkaTopic)
      
      // Validate CDC events
      validatedStream = StreamAlgebra[S].filter(cdcStream)(validateCDCEvent)
      
      // Apply quality checks
      qualityCheckedStream <- applyQualityChecks(validatedStream)
      
      // Process CDC operations
      processedStream = StreamAlgebra[S].map(qualityCheckedStream)(processCDCOperation)
      
      // Write to Delta Lake with SCD2 pattern
      _ <- writeToDeltaWithSCD2(processedStream, deltaTablePath)
      
    } yield ()
  }
  
  private def validateCDCEvent(event: CDCEvent[CustomerCDC]): Boolean = {
    event.operation match {
      case Insert => event.after.isDefined && event.before.isEmpty
      case Update => event.after.isDefined && event.before.isDefined
      case Delete => event.before.isDefined && event.after.isEmpty
    }
  }
  
  private def applyQualityChecks(
    stream: S[CDCEvent[CustomerCDC]]
  ): F[S[CDCEvent[CustomerCDC]]] = {
    
    val qualityRules = List(
      QualityRule("email_format", "Email must be valid format") { event =>
        event.after.forall(_.email.contains("@"))
      },
      QualityRule("customer_id_positive", "Customer ID must be positive") { event =>
        event.after.forall(_.customerId > 0)
      },
      QualityRule("status_valid", "Status must be valid") { event =>
        event.after.forall(c => Set("active", "inactive", "suspended").contains(c.status))
      }
    )
    
    EffectSystem[F].pure(
      StreamAlgebra[S].filter(stream) { event =>
        qualityRules.forall(_.validate(event))
      }
    )
  }
  
  private def processCDCOperation(event: CDCEvent[CustomerCDC]): DeltaOperation = {
    event.operation match {
      case Insert => DeltaInsert(event.after.get, event.timestamp)
      case Update => DeltaUpdate(
        event.before.get, 
        event.after.get, 
        event.timestamp
      )
      case Delete => DeltaDelete(event.before.get, event.timestamp)
    }
  }
  
  private def writeToDeltaWithSCD2(
    stream: S[DeltaOperation],
    deltaPath: String
  ): F[Unit] = {
    // Implement SCD2 (Slowly Changing Dimensions Type 2) pattern
    // This maintains historical versions of records
    EffectSystem[F].delay {
      StreamAlgebra[S].writeStream(stream) { operations =>
        operations.foreach { op =>
          op match {
            case DeltaInsert(record, timestamp) =>
              insertWithSCD2(record, timestamp, deltaPath)
            case DeltaUpdate(before, after, timestamp) =>
              updateWithSCD2(before, after, timestamp, deltaPath)
            case DeltaDelete(record, timestamp) =>
              deleteWithSCD2(record, timestamp, deltaPath)
          }
        }
      }
    }
  }
  
  private def insertWithSCD2(record: CustomerCDC, timestamp: Instant, path: String): Unit = {
    // Insert new record with effective dates
    val scd2Record = CustomerSCD2(
      customerId = record.customerId,
      name = record.name,
      email = record.email,
      status = record.status,
      effectiveFrom = timestamp,
      effectiveTo = None,
      isCurrent = true,
      version = 1
    )
    // Write to Delta table
  }
  
  private def updateWithSCD2(
    before: CustomerCDC, 
    after: CustomerCDC, 
    timestamp: Instant, 
    path: String
  ): Unit = {
    // Close current record and insert new version
    // 1. Update current record: set effectiveTo = timestamp, isCurrent = false
    // 2. Insert new record: effectiveFrom = timestamp, isCurrent = true, version++
  }
  
  private def deleteWithSCD2(record: CustomerCDC, timestamp: Instant, path: String): Unit = {
    // Soft delete: set effectiveTo = timestamp, isCurrent = false
  }
}

// SCD2 record structure
case class CustomerSCD2(
  customerId: Long,
  name: String,
  email: String,
  status: String,
  effectiveFrom: Instant,
  effectiveTo: Option[Instant],
  isCurrent: Boolean,
  version: Int
)

// Delta operations
sealed trait DeltaOperation
case class DeltaInsert(record: CustomerCDC, timestamp: Instant) extends DeltaOperation
case class DeltaUpdate(before: CustomerCDC, after: CustomerCDC, timestamp: Instant) extends DeltaOperation
case class DeltaDelete(record: CustomerCDC, timestamp: Instant) extends DeltaOperation
```

### CDC Pipeline Testing

```scala mdoc:silent
class CDCPipelineTest extends FlowForgeSpec {
  
  "CDC processor" should "handle all operation types correctly" in {
    val processor = new StreamingCDCProcessor[IO, TestStream]()
    
    val insertEvent = CDCEvent(
      operation = Insert,
      timestamp = Instant.now(),
      before = None,
      after = Some(CustomerCDC(1L, "John Doe", "john@example.com", "active", Instant.now())),
      source = CDCSource("prod_db", "customers", 12345L)
    )
    
    val updateEvent = CDCEvent(
      operation = Update,
      timestamp = Instant.now(),
      before = Some(CustomerCDC(1L, "John Doe", "john@example.com", "active", Instant.now())),
      after = Some(CustomerCDC(1L, "John Smith", "john.smith@example.com", "active", Instant.now())),
      source = CDCSource("prod_db", "customers", 12346L)
    )
    
    val deleteEvent = CDCEvent(
      operation = Delete,
      timestamp = Instant.now(),
      before = Some(CustomerCDC(1L, "John Smith", "john.smith@example.com", "active", Instant.now())),
      after = None,
      source = CDCSource("prod_db", "customers", 12347L)
    )
    
    // Test validation
    processor.validateCDCEvent(insertEvent) shouldBe true
    processor.validateCDCEvent(updateEvent) shouldBe true
    processor.validateCDCEvent(deleteEvent) shouldBe true
    
    // Test invalid events
    val invalidInsert = insertEvent.copy(before = Some(insertEvent.after.get))
    processor.validateCDCEvent(invalidInsert) shouldBe false
  }
}
```

## 4. Multi-Cloud Integration: Unified Data Processing

Modern data architectures span multiple cloud providers. FlowForge's unified connector interface simplifies multi-cloud data processing.

### Multi-Cloud Data Sources

```scala mdoc:silent
import com.flowforge.connectors._

// Unified cloud storage configuration
sealed trait CloudStorage
case class S3Storage(bucket: String, region: String, accessKey: String, secretKey: String) extends CloudStorage
case class AzureStorage(account: String, container: String, sasToken: String) extends CloudStorage
case class GCSStorage(bucket: String, projectId: String, serviceAccountKey: String) extends CloudStorage

// Multi-cloud data source configuration
case class MultiCloudSource(
  name: String,
  storage: CloudStorage,
  path: String,
  format: String,
  schema: String
)

// Customer data distributed across clouds
case class CustomerProfile(
  customerId: Long,
  personalInfo: PersonalInfo,
  preferences: CustomerPreferences,
  activitySummary: ActivitySummary
)

case class PersonalInfo(
  firstName: String,
  lastName: String,
  email: String,
  phone: Option[String]
)

case class CustomerPreferences(
  language: String,
  timezone: String,
  marketingOptIn: Boolean,
  categories: List[String]
)

case class ActivitySummary(
  totalOrders: Long,
  totalSpent: Double,
  lastOrderDate: Option[Instant],
  averageOrderValue: Double
)
```

### Multi-Cloud Data Lake Pipeline

```scala mdoc:silent
class MultiCloudDataLakePipeline[F[_]: EffectSystem, D[_]: DataAlgebra] {
  
  def consolidateCustomerData(
    sources: List[MultiCloudSource],
    outputPath: String
  ): F[Unit] = {
    
    for {
      // Read from multiple cloud sources
      datasets <- EffectSystem[F].parTraverse(sources)(readFromCloudSource)
      
      // Apply data quality checks
      qualityCheckedDatasets <- EffectSystem[F].parTraverse(datasets)(applyDataQuality)
      
      // Consolidate data with schema evolution handling
      consolidatedData <- consolidateDatasets(qualityCheckedDatasets)
      
      // Apply final validation
      validatedData = DataContract.validate(consolidatedData)
      
      // Write to unified output
      _ <- DataAlgebra[D].write(validatedData, outputPath)
      
      // Emit lineage across clouds
      _ <- emitMultiCloudLineage(sources, outputPath)
      
    } yield ()
  }
  
  private def readFromCloudSource(source: MultiCloudSource): F[D[CustomerProfile]] = {
    source.storage match {
      case s3: S3Storage =>
        readFromS3(s3, source.path, source.format)
      case azure: AzureStorage =>
        readFromAzure(azure, source.path, source.format)
      case gcs: GCSStorage =>
        readFromGCS(gcs, source.path, source.format)
    }
  }
  
  private def readFromS3(
    s3: S3Storage, 
    path: String, 
    format: String
  ): F[D[CustomerProfile]] = {
    EffectSystem[F].delay {
      // Configure S3 connector
      val s3Config = S3Config(
        bucket = s3.bucket,
        region = s3.region,
        credentials = S3Credentials(s3.accessKey, s3.secretKey)
      )
      
      // Read with automatic schema validation
      DataAlgebra[D].read[CustomerProfile](s"s3://${s3.bucket}/$path")
        .withConfig(s3Config)
        .withFormat(format)
    }
  }
  
  private def readFromAzure(
    azure: AzureStorage, 
    path: String, 
    format: String
  ): F[D[CustomerProfile]] = {
    EffectSystem[F].delay {
      // Configure Azure Data Lake connector
      val azureConfig = AzureConfig(
        account = azure.account,
        container = azure.container,
        sasToken = azure.sasToken
      )
      
      DataAlgebra[D].read[CustomerProfile](s"abfss://${azure.container}@${azure.account}.dfs.core.windows.net/$path")
        .withConfig(azureConfig)
        .withFormat(format)
    }
  }
  
  private def readFromGCS(
    gcs: GCSStorage, 
    path: String, 
    format: String
  ): F[D[CustomerProfile]] = {
    EffectSystem[F].delay {
      // Configure GCS connector
      val gcsConfig = GCSConfig(
        bucket = gcs.bucket,
        projectId = gcs.projectId,
        serviceAccountKey = gcs.serviceAccountKey
      )
      
      DataAlgebra[D].read[CustomerProfile](s"gs://${gcs.bucket}/$path")
        .withConfig(gcsConfig)
        .withFormat(format)
    }
  }
  
  private def applyDataQuality(dataset: D[CustomerProfile]): F[D[CustomerProfile]] = {
    // Apply comprehensive data quality checks
    val qualityRules = List(
      // Personal info validation
      QualityRule("email_valid", "Email must be valid") { profile =>
        profile.personalInfo.email.contains("@") && 
        profile.personalInfo.email.contains(".")
      },
      
      // Activity validation
      QualityRule("activity_consistent", "Activity data must be consistent") { profile =>
        profile.activitySummary.totalOrders >= 0 &&
        profile.activitySummary.totalSpent >= 0 &&
        profile.activitySummary.averageOrderValue >= 0
      },
      
      // Preferences validation
      QualityRule("preferences_valid", "Preferences must be valid") { profile =>
        Set("en", "es", "fr", "de").contains(profile.preferences.language) &&
        profile.preferences.categories.nonEmpty
      }
    )
    
    EffectSystem[F].pure(
      DataAlgebra[D].filter(dataset) { profile =>
        qualityRules.forall(_.validate(profile))
      }
    )
  }
  
  private def consolidateDatasets(
    datasets: List[D[CustomerProfile]]
  ): F[D[CustomerProfile]] = {
    // Merge datasets with deduplication and conflict resolution
    EffectSystem[F].pure {
      datasets.reduce { (ds1, ds2) =>
        DataAlgebra[D].union(ds1, ds2)
          .groupBy(_.customerId)
          .aggregate(resolveConflicts)
      }
    }
  }
  
  private def resolveConflicts(profiles: D[CustomerProfile]): CustomerProfile = {
    // Implement conflict resolution logic
    // For example: take the most recent data based on activity
    val sortedProfiles = DataAlgebra[D].sortBy(profiles)(
      _.activitySummary.lastOrderDate.getOrElse(Instant.MIN)
    )(Ordering[Instant].reverse)
    
    DataAlgebra[D].head(sortedProfiles)
  }
  
  private def emitMultiCloudLineage(
    sources: List[MultiCloudSource], 
    output: String
  ): F[Unit] = {
    EffectSystem[F].delay {
      val lineageEvent = OpenLineageEvent(
        jobName = "multi-cloud-consolidation",
        inputs = sources.map(s => s"${s.storage}/${s.path}"),
        outputs = List(output),
        engine = "multi-cloud",
        metadata = Map(
          "clouds" -> sources.map(_.storage.getClass.getSimpleName).mkString(","),
          "sources_count" -> sources.length.toString
        )
      )
      OpenLineageEmitter.emit(lineageEvent)
    }
  }
}
```

### Multi-Cloud Testing

```scala mdoc:silent
class MultiCloudIntegrationTest extends FlowForgeSpec {
  
  "Multi-cloud pipeline" should "consolidate data from different cloud providers" in {
    val s3Source = MultiCloudSource(
      name = "s3-customers",
      storage = S3Storage("customer-bucket", "us-east-1", "access-key", "secret-key"),
      path = "customers/profiles",
      format = "parquet",
      schema = "customer_profile_v1"
    )
    
    val azureSource = MultiCloudSource(
      name = "azure-customers",
      storage = AzureStorage("storageaccount", "customers", "sas-token"),
      path = "profiles/latest",
      format = "delta",
      schema = "customer_profile_v2"
    )
    
    val gcsSource = MultiCloudSource(
      name = "gcs-customers",
      storage = GCSStorage("customer-data", "project-id", "service-account-key"),
      path = "customer_profiles",
      format = "avro",
      schema = "customer_profile_v1"
    )
    
    val pipeline = new MultiCloudDataLakePipeline[IO, TestData]()
    val sources = List(s3Source, azureSource, gcsSource)
    
    // Test pipeline execution
    val result = pipeline.consolidateCustomerData(sources, "output/consolidated")
    result.unsafeRunSync()
    
    // Verify lineage emission
    val emittedEvents = OpenLineageEmitter.getEmittedEvents()
    emittedEvents should have size 1
    emittedEvents.head.inputs should have size 3
  }
}
